# Copy this file to .env.production on the Samogon VM. Never commit that copy.
DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=sam.pyconstrictor.ru
CSRF_TRUSTED_ORIGINS=https://sam.pyconstrictor.ru

# Existing PostgreSQL and Redis are resolved in Docker network infra.
DATABASE_URL=postgresql://samogon:replace-with-a-long-database-password@postgres:5432/samogon
# channels-redis выполняет blocking read до 5 секунд; socket timeout должен быть больше.
REDIS_URL=redis://redis:6379/0?socket_timeout=10

OLLAMA_BASE_URL=http://192.168.0.78:11434
OLLAMA_MODEL=samogon-semen-gemma
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TEMPERATURE=0.5
OLLAMA_NUM_PREDICT=80
BARTENDER_RESPONSE_MAX_LENGTH=200
BARTENDER_USERNAME=semen

# Закрытая бета: передайте этот код только приглашённым тестерам.
REGISTRATION_INVITE_CODE=replace-with-a-long-random-invite-code
# Не включайте открытую регистрацию, пока не заданы оба ключа Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
MESSAGE_RATE_LIMIT=20
BARTENDER_RATE_LIMIT=5
REACTION_RATE_LIMIT=30
TYPING_RATE_LIMIT=60

# SMTP нужен для писем восстановления доступа и уведомлений.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Samogon <noreply@example.com>

# Shared directories mounted into samogon-web and the existing nginx container.
SAMOGON_DATA_DIR=/srv/data/samogon

# Образ публикуется GitHub Actions в Docker Hub.
SAMOGON_IMAGE=docker.io/alserloz/samogon_chat:latest

# Безопасные вложения: до 3 файлов в сообщении, 5 МБ для изображения и 2 МБ для документа.
ATTACHMENT_MAX_COUNT=3
ATTACHMENT_IMAGE_MAX_SIZE=5242880
ATTACHMENT_FILE_MAX_SIZE=2097152
ATTACHMENT_RATE_LIMIT=10
