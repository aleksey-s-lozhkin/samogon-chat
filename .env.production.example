# Copy this file to .env.production on the Samogon VM. Never commit that copy.
# DEBUG=0 — режим по умолчанию: без явного DEBUG=1 приложение не стартует без
# SECRET_KEY, а без DATABASE_URL не откатывается молча на SQLite.
DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=app.example.invalid
CSRF_TRUSTED_ORIGINS=https://app.example.invalid

# Existing PostgreSQL and Redis are resolved in Docker network infra.
DATABASE_URL=postgresql://samogon:replace-with-a-long-database-password@postgres:5432/samogon
# channels-redis выполняет blocking read до 5 секунд; socket timeout должен быть больше.
REDIS_URL=redis://redis:6379/0?socket_timeout=10
PRESENCE_TTL_SECONDS=75

OLLAMA_BASE_URL=http://ollama.internal:11434
OLLAMA_MODEL=samogon-semen-caretaker
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TEMPERATURE=0.5
OLLAMA_NUM_PREDICT=120
BARTENDER_RESPONSE_MAX_LENGTH=360
BARTENDER_USERNAME=semen

# Закрытая бета: передайте этот код только приглашённым тестерам.
# 1 — открытая регистрация без приглашений; 0 — прежний режим.
REGISTRATION_OPEN=0
REGISTRATION_INVITE_CODE=replace-with-a-long-random-invite-code
# Не включайте открытую регистрацию, пока не заданы оба ключа Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT=5
MESSAGE_RATE_LIMIT=20
BARTENDER_RATE_LIMIT=5
REACTION_RATE_LIMIT=30
TYPING_RATE_LIMIT=60
# Ограничения WebSocket: размер одного кадра и число вкладок одного гостя.
WEBSOCKET_MAX_FRAME_BYTES=16384
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5

# SMTP нужен для писем восстановления доступа и уведомлений.
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.invalid
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Samogon <noreply@example.invalid>

# OAuth callback URLs:
# https://app.example.invalid/accounts/github/login/callback/
# https://app.example.invalid/accounts/google/login/callback/
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Web Push включится только при наличии обоих VAPID-ключей.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.invalid

# Shared directories mounted into samogon-web and the existing nginx container.
SAMOGON_DATA_DIR=/srv/data/samogon

# Образ публикуется GitHub Actions в Docker Hub.
SAMOGON_IMAGE=alserloz/samogon_chat:latest

# Аудио: лимиты читаются из этих переменных, поэтому держите их здесь.
AUDIO_MESSAGE_MAX_SIZE=10485760
AUDIO_MESSAGE_MAX_DURATION_SECONDS=180
FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=10
FFMPEG_BINARY=ffmpeg
AUDIO_TRANSCODE_TIMEOUT_SECONDS=60
ATTACHMENT_RATE_LIMIT=10
PRESENCE_STATUS_RATE_LIMIT=20
PUSH_SELF_TEST_RATE_LIMIT=3
MESSAGE_REPORT_RATE_LIMIT=10
BARTENDER_CONTEXT_MESSAGE_LIMIT=8
BARTENDER_CONTEXT_MESSAGE_MAX_CHARS=500

# Безопасные вложения: до 3 файлов в сообщении, 5 МБ для изображения и 2 МБ для документа.
ATTACHMENT_MAX_COUNT=3
ATTACHMENT_IMAGE_MAX_SIZE=5242880
ATTACHMENT_FILE_MAX_SIZE=2097152
ATTACHMENT_RATE_LIMIT=10
