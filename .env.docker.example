# Локальный Docker-режим. Скопируйте файл в .env.docker.
DEBUG=1
SECRET_KEY=django-insecure-docker-local-only
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://samogon:samogon@db:5432/samogon
# channels-redis выполняет blocking read до 5 секунд; socket timeout должен быть больше.
REDIS_URL=redis://redis:6379/0?socket_timeout=10

# Docker Desktop может обращаться к Ollama в локальной сети.
OLLAMA_BASE_URL=http://192.168.0.78:11434
OLLAMA_MODEL=samogon-semen-gemma
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TEMPERATURE=0.5
OLLAMA_NUM_PREDICT=80
BARTENDER_RESPONSE_MAX_LENGTH=200
BARTENDER_USERNAME=semen

# Локально код не обязателен. Укажите его, чтобы проверить закрытую регистрацию.
REGISTRATION_INVITE_CODE=
