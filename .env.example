# Скопируйте файл в .env — он подхватывается автоматически при локальном
# запуске. Реальные секреты в репозиторий не добавляются.
# Значения из настоящего окружения всегда имеют приоритет над файлом.

# Локальный режим. В production DEBUG не задаётся (по умолчанию 0),
# а SECRET_KEY и DATABASE_URL обязательны.
DEBUG=1
# Локально ключ можно не задавать: подставляется небезопасный дефолт.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Пусто — локальный SQLite. Для PostgreSQL укажите URL целиком:
# DATABASE_URL=postgresql://user:password@localhost:5432/samogon
DATABASE_URL=

# Необязательно: для нескольких ASGI-процессов и production.
# Если не задано, Channels использует локальный InMemoryChannelLayer.
REDIS_URL=
# Срок жизни WebSocket-присутствия; heartbeat клиента продлевает запись.
PRESENCE_TTL_SECONDS=75

# Локальная Ollama на отдельной VM. Не публикуйте этот порт в интернет.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TEMPERATURE=0.5
OLLAMA_NUM_PREDICT=120
BARTENDER_RESPONSE_MAX_LENGTH=360
# 1 — открытая регистрация без приглашений; 0 — прежний режим.
REGISTRATION_OPEN=0
REGISTRATION_INVITE_CODE=

# Отдельные ключи локальных OAuth-приложений.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Web Push: URL-safe публичный ключ, приватный PEM/base64url-ключ и контакт.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
